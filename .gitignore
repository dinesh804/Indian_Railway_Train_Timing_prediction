@"
# Secrets and environment variables
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/

# IDE and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
tmp/
temp/

# Model artifacts and large datasets — review before publishing
"@ | Set-Content -Encoding utf8 .gitignore